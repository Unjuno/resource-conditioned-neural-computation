# Physical DE0-CV Q15 reference run: values are extracted from the signed Stage2 RV32 720-case gate.
load_package jtag
proc rtnn_crc32 {bytes} {set crc 0xffffffff; foreach b $bytes {set c [expr {$crc ^ ($b & 0xff)}]; for {set i 0} {$i < 8} {incr i} {if {$c & 1} {set c [expr {(($c >> 1) ^ 0xedb88320) & 0xffffffff}]} else {set c [expr {($c >> 1) & 0xffffffff}]}}; set crc $c}; return [expr {(~$crc) & 0xffffffff}]}
proc rtnn_pack_lsb_hex {bytes} {set out ""; for {set i [expr {[llength $bytes]-1}]} {$i >= 0} {incr i -1} {append out [format %02x [lindex $bytes $i]]}; return $out}
proc rtnn_unpack_lsb_hex {hex count} {set hex [string trim $hex]; regsub -all {^(0x|0X)} $hex {} hex; if {[expr {[string length $hex] % 2}]} {set hex "0$hex"}; set hex [string tolower $hex]; set hex [string repeat 0 [expr {2*$count-[string length $hex]}]]$hex; if {[string length $hex] != 2*$count} {error "unexpected scan width: $hex"}; set out {}; for {set i [expr {[string length $hex]-2}]} {$i >= 0} {incr i -2} {scan [string range $hex $i [expr {$i+1}]] %x b; lappend out $b}; return $out}
proc rtnn_make_request {mode depth seq input_id} {set b [lrepeat 32 0]; foreach {i v} {0 0x52 1 0x54 2 0x4e 3 0x51 4 1} {lset b $i $v}; lset b 5 $mode; lset b 6 $depth; for {set i 0} {$i < 4} {incr i} {lset b [expr {8+$i}] [expr {($seq >> (8*$i)) & 255}]}; lset b 12 [expr {$input_id & 255}]; lset b 13 [expr {($input_id >> 8) & 255}]; lset b 14 0xff; lset b 15 0xff; foreach {i v} {20 0x4e 21 0x4e 22 0x54 23 0x52 24 0x32 25 0x30 26 0x56 27 0x44} {lset b $i $v}; set crc [rtnn_crc32 [lrange $b 0 27]]; for {set i 0} {$i < 4} {incr i} {lset b [expr {28+$i}] [expr {($crc >> (8*$i)) & 255}]}; return $b}
proc rtnn_jtag_scan {instance ir length value_hex} {device_virtual_ir_shift -instance_index $instance -ir_value $ir -no_captured_ir_value; if {$value_hex eq ""} {return [device_virtual_dr_shift -instance_index $instance -length $length -value_in_hex]}; return [device_virtual_dr_shift -instance_index $instance -length $length -dr_value $value_hex -value_in_hex]}
proc rtnn_run_one {instance mode depth seq input_id expected_pred expected_admit expected_exec expected_stop expected_label} {set req [rtnn_make_request $mode $depth $seq $input_id]; set req_hex [rtnn_pack_lsb_hex $req]; rtnn_jtag_scan $instance 1 256 $req_hex; set status 0; for {set poll 0} {$poll < 20000} {incr poll} {set s [rtnn_jtag_scan $instance 3 8 ""]; scan $s %x status; if {(($status >> 5) & 1) && !(($status >> 4) & 1)} {break}; after 1}; if {(($status >> 5) & 1) == 0 || (($status >> 4) & 1) != 0 || (($status >> 6) & 3) != 0} {error [format "diagnostic status timeout/error: 0x%02x" $status]}; set response_hex [rtnn_jtag_scan $instance 2 384 ""]; set r [rtnn_unpack_lsb_hex $response_hex 48]; if {[lrange $r 0 3] ne {82 84 78 82}} {error "bad RTNR magic"}; if {[lindex $r 4] != 1 || [lindex $r 5] != 0 || [lindex $r 6] != $mode} {error "bad RTNR version/status/mode"}; set got_seq 0; for {set i 0} {$i < 4} {incr i} {set got_seq [expr {$got_seq | ([lindex $r [expr {8+$i}]] << (8*$i))}]}; if {$got_seq != $seq} {error "RTNR sequence mismatch"}; set got_input [expr {[lindex $r 12] | ([lindex $r 13] << 8)}]; if {$got_input != $input_id} {error "RTNR input_id mismatch"}; foreach {idx expected name} [list 20 $expected_admit admitted 21 $expected_exec executed 22 $expected_pred prediction 23 $expected_label label 7 $expected_stop stop] {if {[lindex $r $idx] != $expected} {error "$name mismatch: got [lindex $r $idx], expected $expected"}}; if {[lrange $r 28 31] ne {78 78 84 82} || [lrange $r 32 35] ne {50 48 86 68}} {error "RTNR model/build identity mismatch"}; set got_crc 0; for {set i 0} {$i < 4} {incr i} {set got_crc [expr {$got_crc | ([lindex $r [expr {44+$i}]] << (8*$i))}]}; set want_crc [rtnn_crc32 [lrange $r 0 43]]; if {$got_crc != $want_crc} {error "RTNR CRC mismatch"}; set cycles 0; for {set i 0} {$i < 4} {incr i} {set cycles [expr {$cycles | ([lindex $r [expr {24+$i}]] << (8*$i))}]}; puts [format "VJTAG_Q15_PASS mode=%d input_id=%d seq=%d prediction=%d label=%d admitted=%d executed=%d stop=%d mcycle=%u crc=%08x" $mode $input_id $seq [lindex $r 22] [lindex $r 23] [lindex $r 20] [lindex $r 21] [lindex $r 7] $cycles $got_crc]}
proc rtnn_run {} {set hw ""; foreach c [get_hardware_names] {if {[string match "USB-Blaster*" $c]} {set hw $c; break}}; if {$hw eq ""} {error "USB-Blaster not found"}; set dev ""; foreach c [get_device_names -hardware_name $hw] {if {[string match "@1*" $c]} {set dev $c; break}}; if {$dev eq ""} {error "expected first JTAG device not found"}; set casefile [file join [file dirname [info script]] physical_cases.csv]; set f [open $casefile r]; gets $f; open_device -hardware_name $hw -device_name $dev; set locked 0; set rc [catch {device_lock -timeout 10000; set locked 1; set count 0; while {[gets $f line] >= 0} {if {$line eq ""} continue; lassign [split $line ,] mode input_id seq fixed_exit budget admitted executed prediction label stop refcycles; if {$mode == 1} {set depth $fixed_exit} elseif {$mode == 3} {set depth $fixed_exit} else {error "unsupported mode $mode"}; rtnn_run_one 0 $mode $depth $seq $input_id $prediction $admitted $executed $stop $label; incr count}; if {$count != 20} {error "expected 20 validated cases, ran $count"}; puts "VJTAG_Q15_CASES_PASS count=$count fixed=10 adaptive=10"} msg opts]; catch {close $f}; if {$locked} {catch {device_unlock}}; catch {close_device}; if {$rc} {return -options $opts $msg}}
if {$argc > 0 && [lindex $argv 0] eq "run"} {rtnn_run}

