; Set False Path                                                                                                                                  ;
+----------------+-------+------------+----------------------+---------+----------+--------------------------------+-------------------+----------+
; SDC Command    ; Flags ; From Flags ; From                 ; Through ; To Flags ; To                             ; Location          ; Comments ;
+----------------+-------+------------+----------------------+---------+----------+--------------------------------+-------------------+----------+
; set_false_path ;       ; -from      ; [get_ports {KEY[0]}] ;         ; -to      ; [get_registers {*rst_pipe_q*}] ; rtnn_de0_cv.sdc:5 ;          ;
+----------------+-------+------------+----------------------+---------+----------+--------------------------------+-------------------+----------+

