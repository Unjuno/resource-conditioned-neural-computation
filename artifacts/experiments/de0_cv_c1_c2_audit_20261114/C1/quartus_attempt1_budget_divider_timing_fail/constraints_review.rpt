+---------------+------------+-------------------+---------+----------+-----------------------------------------------+--------+--------------------+----------+
; set_max_delay ; -from      ; [get_registers *] ;         ; -to      ; [get_ports {LEDR[0] LEDR[1] LEDR[2] LEDR[3]}] ; 20.000 ; rtnn_de0_cv.sdc:14 ;          ;
+---------------+------------+-------------------+---------+----------+-----------------------------------------------+--------+--------------------+----------+

