+-------------------------------------------------------------------------------------------------------------------------+
; Create Clock                                                                                                            ;
+--------------+----------+--------+------------------+------------------------+-----------+-------------------+----------+
; SDC Command  ; Name     ; Period ; Waveform         ; Targets                ; Add Clock ; Location          ; Comments ;
+--------------+----------+--------+------------------+------------------------+-----------+-------------------+----------+
; create_clock ; CLOCK_50 ; 20.000 ; { 0.000 10.000 } ; [get_ports {CLOCK_50}] ;           ; rtnn_de0_cv.sdc:1 ;          ;
+--------------+----------+--------+------------------+------------------------+-----------+-------------------+----------+

+-------------------------------------------------------------------------------------------------------------------------------------------------+
; Set Clock Uncertainty                                                                                                                           ;
+-----------------------+--------+------------+-------------------------+----------+-------------------------+-------------+-----------+----------+
; SDC Command           ; Flags  ; From Flags ; From                    ; To Flags ; To                      ; Uncertainty ; Source    ; Comments ;
+-----------------------+--------+------------+-------------------------+----------+-------------------------+-------------+-----------+----------+
; set_clock_uncertainty ; -setup ; -rise_from ; [get_clocks {CLOCK_50}] ; -rise_to ; [get_clocks {CLOCK_50}] ; 0.100       ; Generated ;          ;
; set_clock_uncertainty ; -hold  ; -rise_from ; [get_clocks {CLOCK_50}] ; -rise_to ; [get_clocks {CLOCK_50}] ; 0.060       ; Generated ;          ;
; set_clock_uncertainty ; -setup ; -rise_from ; [get_clocks {CLOCK_50}] ; -fall_to ; [get_clocks {CLOCK_50}] ; 0.100       ; Generated ;          ;
; set_clock_uncertainty ; -hold  ; -rise_from ; [get_clocks {CLOCK_50}] ; -fall_to ; [get_clocks {CLOCK_50}] ; 0.060       ; Generated ;          ;
; set_clock_uncertainty ; -setup ; -fall_from ; [get_clocks {CLOCK_50}] ; -rise_to ; [get_clocks {CLOCK_50}] ; 0.100       ; Generated ;          ;
; set_clock_uncertainty ; -hold  ; -fall_from ; [get_clocks {CLOCK_50}] ; -rise_to ; [get_clocks {CLOCK_50}] ; 0.060       ; Generated ;          ;
; set_clock_uncertainty ; -setup ; -fall_from ; [get_clocks {CLOCK_50}] ; -fall_to ; [get_clocks {CLOCK_50}] ; 0.100       ; Generated ;          ;
; set_clock_uncertainty ; -hold  ; -fall_from ; [get_clocks {CLOCK_50}] ; -fall_to ; [get_clocks {CLOCK_50}] ; 0.060       ; Generated ;          ;
+-----------------------+--------+------------+-------------------------+----------+-------------------------+-------------+-----------+----------+

