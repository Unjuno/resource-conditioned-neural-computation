FROM python:3.13.5-slim
WORKDIR /workspace
RUN pip install --no-cache-dir torch==2.10.0 --index-url https://download.pytorch.org/whl/cpu
COPY experiments/realtime_nn_sequence_nested_routing.py experiments/realtime_nn_continuous_horizon_value.py experiments/
COPY container/run_continuous_horizon_value.sh container/
CMD ["bash", "container/run_continuous_horizon_value.sh"]
