FROM python:3.13.5-slim
RUN pip install --no-cache-dir torch==2.10.0 --index-url https://download.pytorch.org/whl/cpu
WORKDIR /workspace
COPY experiments/realtime_nn_sequence_nested_routing.py experiments/
COPY experiments/realtime_nn_sequence_cap_preference.py experiments/
COPY container/run_sequence_nested_cap_audits.sh container/
RUN mkdir -p results && chmod +x container/run_sequence_nested_cap_audits.sh
ENV PYTHONPATH=/workspace/experiments
CMD ["container/run_sequence_nested_cap_audits.sh"]
